<UserControl x:Class="LundyUI.Controls.CustomControls.MenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LundyUI.Controls.CustomControls"
             xmlns:converters="clr-namespace:LundyUI.Controls.Converters"
             Background="{DynamicResource WindowBackBrush}">
    <UserControl.Resources>
        <converters:BoolToExpandSymbolConverter x:Key="BoolToExpandSymbol"/>
        <converters:IconGlyphConverter x:Key="IconGlyph"/>
        <converters:StringToVisibilityConverter x:Key="Str2Vis"/>
        <converters:PathToImageConverter x:Key="PathToImage"/>

        <DataTemplate x:Key="MenuEntryTemplate" DataType="{x:Type local:MenuNode}">
            <Border Padding="8,6"
                    Visibility="{Binding MenuShow}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource MenuItemBackBrush}"/>
                        <Setter Property="Margin" Value="25,4,10,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MenuExpand, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Collapsed">
                                <Setter Property="Margin" Value="8,4,8,4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MenuExpand, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Collapsed">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4" Margin="0,2,8,2" CornerRadius="2"
                            Background="{DynamicResource AccentBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MenuExpand, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Collapsed">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <!-- 模式A 双属性图标：Icon(字体MDI) 优先，空则回落 ImagePath(图片)，皆空隐藏 -->
                    <Grid Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock FontSize="18" TextAlignment="Center"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Icon, Converter={StaticResource Str2Vis}}"/>
                        <Image Width="18" Height="18" Stretch="Uniform"
                               Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ImagePath, Converter={StaticResource Str2Vis}}"/>
                    </Grid>
                    <TextBlock Grid.Column="2" FontSize="15"
                               Foreground="{DynamicResource MenuItemTextBrush}" Text="{Binding Name}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding MenuExpand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MenuCategoryTemplate" DataType="{x:Type local:MenuNode}">
            <Border Margin="0,8,0,0" Padding="14,8,10,8"
                    Background="{DynamicResource MenuItemBackBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid Visibility="{Binding MenuExpand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" CornerRadius="2"/>
                        <!-- 模式A 双属性图标：Icon(字体MDI) 优先，空则回落 ImagePath(图片)，皆空隐藏 -->
                        <Grid Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock FontSize="18" TextAlignment="Center"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Icon, Converter={StaticResource Str2Vis}}"/>
                            <Image Width="18" Height="18" Stretch="Uniform"
                                   Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding ImagePath, Converter={StaticResource Str2Vis}}"/>
                        </Grid>
                        <TextBlock Grid.Column="2" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Text="{Binding Name}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandSymbol}}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 折叠态：仅显示字体图标或图片图标 -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MenuExpand, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Collapsed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock FontSize="26" FontFamily="{DynamicResource IconFontFamily}"
                                   Text="{Binding Icon, Converter={StaticResource IconGlyph}}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Icon, Converter={StaticResource Str2Vis}}"/>
                        <Image Width="26" Height="26" Stretch="Uniform"
                               Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding ImagePath, Converter={StaticResource Str2Vis}}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <local:MenuTemplateSelector x:Key="MenuTemplateSelector"
                                    CategoryTemplate="{StaticResource MenuCategoryTemplate}"
                                    ItemTemplate="{StaticResource MenuEntryTemplate}"/>
    </UserControl.Resources>

    <ListBox x:Name="MenuListBox"
             Background="{DynamicResource WindowBackBrush}"
             ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
             SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
             VirtualizingPanel.ScrollUnit="Item"
             BorderThickness="0"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ItemTemplateSelector="{StaticResource MenuTemplateSelector}"
             SelectionChanged="OnMenuListBoxSelectionChanged">
        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MenuItemHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MenuItemSelectedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ListBox.ItemContainerStyle>
    </ListBox>
</UserControl>
