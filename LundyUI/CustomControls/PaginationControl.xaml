<UserControl x:Class="LundyUI.Controls.CustomControls.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="12"
             Foreground="{DynamicResource TextOnDarkBrush}">
    <UserControl.Resources>
        <!-- 分页小按钮：基于库内 Button 隐式样式，仅覆盖尺寸 -->
        <Style x:Key="PageButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="PrevButton" Style="{StaticResource PageButtonStyle}" Content="◀" Click="OnPrevClick" />
        <ItemsControl x:Name="PageButtonsHost" />
        <Button x:Name="NextButton" Style="{StaticResource PageButtonStyle}" Content="▶" Click="OnNextClick" />
        <StackPanel x:Name="JumpPanel" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed">
            <TextBlock Text="跳至" VerticalAlignment="Center" />
            <TextBox x:Name="JumpBox" Width="48" Height="24" Margin="4,0" VerticalContentAlignment="Center" KeyDown="OnJumpKeyDown" />
            <Button Style="{StaticResource PageButtonStyle}" Content="GO" Click="OnJumpClick" />
        </StackPanel>
    </StackPanel>
</UserControl>