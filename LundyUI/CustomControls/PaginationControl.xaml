<UserControl x:Class="LundyUI.WPF.CustomControls.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontSize="12"
             Foreground="{DynamicResource TextDarkBrush}"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 分页小按钮：◀ ▶ GO（基于库内 Button 隐式样式，仅覆盖尺寸，主题跟随） -->
        <Style x:Key="PageButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource PanelBackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- 上一页 -->
        <Button x:Name="PrevButton" Style="{StaticResource PageButtonStyle}" Content="◀" Click="OnPrevClick" />
        <!-- 当前页 / 总页数 -->
        <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Margin="8,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
        <!-- 下一页 -->
        <Button x:Name="NextButton" Style="{StaticResource PageButtonStyle}" Content="▶" Margin="2,0,0,0" Click="OnNextClick" />
        <!-- 跳转输入框：仅整数 1~总页数，非法输入自动忽略 -->
        <TextBox x:Name="JumpBox" Width="44" Height="24" Margin="8,0,0,0"
                 VerticalContentAlignment="Center"
                 PreviewTextInput="OnJumpPreviewTextInput"
                 KeyDown="OnJumpKeyDown" />
        <Button x:Name="JumpGo" Style="{StaticResource PageButtonStyle}" Content="GO" Click="OnJumpClick" />
    </StackPanel>
</UserControl>
