<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Calendar.xaml：日历控件族模板（原生控件外观，无硬编码色值）
         覆盖：Calendar / DatePicker / CalendarItem / CalendarDayButton / CalendarButton
         颜色一律 DynamicResource 引用主题调色键，跟随主题切换。
         注意：CalendarItem 的 PART_MonthView 必须含 7 个星期标题 + 42 个
               CalendarDayButton，符合 WPF 框架的子元素数量/顺序契约。
         ============================================================ -->

    <!-- Calendar：顶部导航条 + 日历容器 -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource PanelBackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="0"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DatePicker：输入框 + 日期按钮 + 弹出日历 -->
    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource PanelBackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Grid.Column="0"
                                               Text="{TemplateBinding Text}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               Padding="2,0"
                                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                               Focusable="{TemplateBinding Focusable}"
                                               IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                               IsEnabled="{TemplateBinding IsEnabled}"
                                               HorizontalAlignment="Stretch" />
                            <Button x:Name="PART_Button"
                                    Grid.Column="1"
                                    Width="22"
                                    Height="22"
                                    Margin="1,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Foreground="{TemplateBinding Foreground}">
                                <Path Data="M 0,0 L 4,0 L 4,4 L 0,4 Z M 0,6 L 4,6 L 4,10 L 0,10 Z M 6,0 L 10,0 L 10,4 L 6,4 Z M 6,6 L 10,6 L 10,10 L 6,10 Z"
                                      Fill="{TemplateBinding Foreground}"
                                      Stretch="Uniform"
                                      Width="12"
                                      Height="12" />
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Calendar SelectedDate="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          DisplayDate="{Binding DisplayDate, RelativeSource={RelativeSource TemplatedParent}}"
                                          DisplayDateStart="{Binding DisplayDateStart, RelativeSource={RelativeSource TemplatedParent}}"
                                          DisplayDateEnd="{Binding DisplayDateEnd, RelativeSource={RelativeSource TemplatedParent}}"
                                          FirstDayOfWeek="{Binding FirstDayOfWeek, RelativeSource={RelativeSource TemplatedParent}}"
                                          IsTodayHighlighted="{Binding IsTodayHighlighted, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{DynamicResource PanelBackBrush}"
                                          Foreground="{DynamicResource TextDarkBrush}"
                                          BorderBrush="{DynamicResource BorderNormalBrush}" />
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarItem：日历容器模板（顶部月份导航条 + 月视图/年视图；PART 名称必须与 WPF CalendarItem 约定一致） -->
    <Style TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="DayTitleTemplate">
                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,4" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_Root" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- 顶部导航条：月份标题 + 前后翻页 -->
                            <Border Grid.Row="0" Background="{DynamicResource PanelLightBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                <Button x:Name="PART_HeaderButton" Style="{x:Null}" Background="Transparent" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" Cursor="Hand" Padding="8,4">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentControl Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Focusable="False" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_PreviousButton" Style="{x:Null}" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Width="26" Height="26" Margin="4,2" Focusable="False" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Path Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="PART_NextButton" Style="{x:Null}" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="26" Margin="4,2" Focusable="False" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Path Data="M 0,0 L 0,8 L 5,4 Z" Fill="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            </Border>
                            <!-- 月视图（星期标题 + 42 天） -->
                            <Grid x:Name="PART_MonthView" Grid.Row="1" Margin="6,4" Visibility="Visible">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Margin="0,2" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_0" Grid.Row="1" Grid.Column="0" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_1" Grid.Row="1" Grid.Column="1" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_2" Grid.Row="1" Grid.Column="2" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_3" Grid.Row="1" Grid.Column="3" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_4" Grid.Row="1" Grid.Column="4" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_5" Grid.Row="1" Grid.Column="5" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_6" Grid.Row="1" Grid.Column="6" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_7" Grid.Row="2" Grid.Column="0" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_8" Grid.Row="2" Grid.Column="1" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_9" Grid.Row="2" Grid.Column="2" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_10" Grid.Row="2" Grid.Column="3" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_11" Grid.Row="2" Grid.Column="4" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_12" Grid.Row="2" Grid.Column="5" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_13" Grid.Row="2" Grid.Column="6" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_14" Grid.Row="3" Grid.Column="0" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_15" Grid.Row="3" Grid.Column="1" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_16" Grid.Row="3" Grid.Column="2" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_17" Grid.Row="3" Grid.Column="3" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_18" Grid.Row="3" Grid.Column="4" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_19" Grid.Row="3" Grid.Column="5" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_20" Grid.Row="3" Grid.Column="6" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_21" Grid.Row="4" Grid.Column="0" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_22" Grid.Row="4" Grid.Column="1" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_23" Grid.Row="4" Grid.Column="2" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_24" Grid.Row="4" Grid.Column="3" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_25" Grid.Row="4" Grid.Column="4" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_26" Grid.Row="4" Grid.Column="5" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_27" Grid.Row="4" Grid.Column="6" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_28" Grid.Row="5" Grid.Column="0" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_29" Grid.Row="5" Grid.Column="1" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_30" Grid.Row="5" Grid.Column="2" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_31" Grid.Row="5" Grid.Column="3" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_32" Grid.Row="5" Grid.Column="4" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_33" Grid.Row="5" Grid.Column="5" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_34" Grid.Row="5" Grid.Column="6" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_35" Grid.Row="6" Grid.Column="0" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_36" Grid.Row="6" Grid.Column="1" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_37" Grid.Row="6" Grid.Column="2" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_38" Grid.Row="6" Grid.Column="3" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_39" Grid.Row="6" Grid.Column="4" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_40" Grid.Row="6" Grid.Column="5" />
                                <CalendarDayButton x:Name="PART_CalendarDayButton_41" Grid.Row="6" Grid.Column="6" />
                            </Grid>
                            <!-- 年视图（月/年选择，4x4） -->
                            <Grid x:Name="PART_YearView" Grid.Row="1" Margin="6,4" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CalendarButton x:Name="PART_CalendarButton_0" Grid.Row="0" Grid.Column="0" />
                                <CalendarButton x:Name="PART_CalendarButton_1" Grid.Row="0" Grid.Column="1" />
                                <CalendarButton x:Name="PART_CalendarButton_2" Grid.Row="0" Grid.Column="2" />
                                <CalendarButton x:Name="PART_CalendarButton_3" Grid.Row="0" Grid.Column="3" />
                                <CalendarButton x:Name="PART_CalendarButton_4" Grid.Row="1" Grid.Column="0" />
                                <CalendarButton x:Name="PART_CalendarButton_5" Grid.Row="1" Grid.Column="1" />
                                <CalendarButton x:Name="PART_CalendarButton_6" Grid.Row="1" Grid.Column="2" />
                                <CalendarButton x:Name="PART_CalendarButton_7" Grid.Row="1" Grid.Column="3" />
                                <CalendarButton x:Name="PART_CalendarButton_8" Grid.Row="2" Grid.Column="0" />
                                <CalendarButton x:Name="PART_CalendarButton_9" Grid.Row="2" Grid.Column="1" />
                                <CalendarButton x:Name="PART_CalendarButton_10" Grid.Row="2" Grid.Column="2" />
                                <CalendarButton x:Name="PART_CalendarButton_11" Grid.Row="2" Grid.Column="3" />
                                <CalendarButton x:Name="PART_CalendarButton_12" Grid.Row="3" Grid.Column="0" />
                                <CalendarButton x:Name="PART_CalendarButton_13" Grid.Row="3" Grid.Column="1" />
                                <CalendarButton x:Name="PART_CalendarButton_14" Grid.Row="3" Grid.Column="2" />
                                <CalendarButton x:Name="PART_CalendarButton_15" Grid.Row="3" Grid.Column="3" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarDayButton：天按钮（选中=主题强调色+强调文字；非当月=弱化文字；悬停=面板亮档；今天=强调色描边） -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="DayButtonBorder" Background="Transparent" CornerRadius="3">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DayButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource PanelLightBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DayButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource AccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup Name="SelectionStates">
                                <VisualState Name="Unselected" />
                                <VisualState Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DayButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource AccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DayButtonContent" Storyboard.TargetProperty="(TextElement.Foreground)">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource TextOnAccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState Name="SelectedUnfocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DayButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource AccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DayButtonContent" Storyboard.TargetProperty="(TextElement.Foreground)">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource TextOnAccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState Name="UnselectedFocused" />
                            </VisualStateGroup>
                            <VisualStateGroup Name="ActiveStates">
                                <VisualState Name="Active" />
                                <VisualState Name="Inactive">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DayButtonContent" Storyboard.TargetProperty="(TextElement.Foreground)">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource TextMutedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup Name="CalendarButtonFocusStates">
                                <VisualState Name="CalendarButtonFocused" />
                                <VisualState Name="CalendarButtonUnfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="DayButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="DayButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="DayButtonBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarButton：月/年视图按钮（年视图切换用，同明暗原则） -->
    <Style TargetType="CalendarButton">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="3">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="MouseOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource PanelLightBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource AccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup Name="SelectionStates">
                                <VisualState Name="Unselected" />
                                <VisualState Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource AccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="(TextElement.Foreground)">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource TextOnAccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState Name="SelectedUnfocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource AccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="(TextElement.Foreground)">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource TextOnAccentBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState Name="UnselectedFocused" />
                            </VisualStateGroup>
                            <VisualStateGroup Name="ActiveStates">
                                <VisualState Name="Active" />
                                <VisualState Name="Inactive">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ButtonContent" Storyboard.TargetProperty="(TextElement.Foreground)">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource TextMutedBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup Name="CalendarButtonFocusStates">
                                <VisualState Name="CalendarButtonFocused" />
                                <VisualState Name="CalendarButtonUnfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>