<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:custom="clr-namespace:LundyUI.WPF.CustomControls">

    <!-- ============================================================
         TouchVerticalSplitter 隐式样式：触摸友好的垂直分隔条
         视觉：细线 + 圆形手柄；分隔条所在 Auto 列即透明分隔槽（槽宽 = 2*TouchHotExpand）
         拖动：鼠标走原生 GridSplitter（Stretch 对齐）；触摸走 Manipulation
         ============================================================ -->
    <Style TargetType="{x:Type custom:TouchVerticalSplitter}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="Cursor" Value="SizeWE"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type custom:TouchVerticalSplitter}">
                    <Grid Background="Transparent">

                        <!-- 视觉细线：水平居中，高度可调 -->
                        <Border x:Name="PART_VisualLine"
                                Width="{TemplateBinding VisualLineWidth}"
                                Height="{TemplateBinding HandleLineHeight}"
                                CornerRadius="1"
                                Background="{DynamicResource SplitterBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        <!-- 拖拽手柄：圆形圆点 -->
                        <Ellipse x:Name="PART_Handle"
                                 Width="{TemplateBinding HandleSize}"
                                 Height="{TemplateBinding HandleSize}"
                                 Fill="{DynamicResource SplitterGripBrush}"
                                 Stroke="{DynamicResource SplitterGripBorderBrush}"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- 悬停 → 细线变亮（提示可拖动） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_VisualLine" Property="Background" Value="{DynamicResource SplitterGripBrush}"/>
                        </Trigger>

                        <!-- 按下/拖动 → 线条 + 手柄高亮（鼠标与触摸统一由 IsDraggingVisual 驱动） -->
                        <Trigger Property="IsDraggingVisual" Value="True">
                            <Setter TargetName="PART_VisualLine" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="PART_Handle" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="PART_Handle" Property="Stroke" Value="#FFFFFFFF"/>
                        </Trigger>

                        <!-- 禁用态 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_VisualLine" Property="Opacity" Value="0.3"/>
                            <Setter TargetName="PART_Handle" Property="Opacity" Value="0.3"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
