<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LundyUI.Demo</RootNamespace>
    <AssemblyName>LundyUI.Demo</AssemblyName>
    <Product>LundyUI</Product>
    <AssemblyTitle>LundyUI 主题样板 Demo</AssemblyTitle>
    <ApplicationIcon>..\LundyUI\Resources\Images\L-EXE.ico</ApplicationIcon>
    <Company>LundyUI</Company>
  </PropertyGroup>
  <ItemGroup>
    <!-- ================================================================
         引用方式：默认使用【工程引用】进行开发/调试。

         切换方法：
           A. 开发模式（默认，推荐）：保留下方 ProjectReference，注释 PackageReference。
           B. 验证发布包（临时）：注释 ProjectReference，启用 PackageReference。

         ⚠ 两者不要同时启用，否则会因同一程序集来自两个来源而报「重复引用/程序集冲突」。
         ================================================================ -->
    <ProjectReference Include="..\LundyUI\LundyUI.WPF.csproj" />
    <!-- <PackageReference Include="LundyUI.WPF" Version="1.0.5" /> -->
  </ItemGroup>
  <ItemGroup>
    <!-- 主题/菜单 json 复制到输出目录：App 启动经 ThemeManager.ConfigBasePath 读取 -->
    <None Update="Configs\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>


