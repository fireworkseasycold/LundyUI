<UserControl x:Class="LundyUI.Demo.ThemePaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:appControls="clr-namespace:LundyUI.Controls.CustomControls;assembly=LundyUI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">

    <UserControl.Resources>
        <!-- 节卡片：每个分类的外框 -->
        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- 展示格：每个控件的演示卡片，宽度在节内统一 -->
        <Style x:Key="DemoCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="点击放大查看" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDarkBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="DemoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- 颜色样例格 -->
        <Style x:Key="ColorSwatchStyle" TargetType="Border">
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderBrush" Value="#66808080" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 用于面板演示的小色块 -->
        <Style x:Key="PanelDemoBlock" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">

                <!-- ============ 标题 ============ -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="🎨 UI 样式样板（Theme Palette）"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextDarkBrush}" />
                        <TextBlock Text="原生 WPF 控件 + 项目自定义控件平铺展示全部主题键效果：文本/背景/下拉框等一律使用标注 key 绑定，禁止混用。修改主题配置后切回本页验收。点击任意展示格可放大预览。"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- ============ 1. 结构背景色 ============ -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="1. 结构背景色（Border.Background）" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource WindowBackBrush}" />
                                    <TextBlock Text="WindowBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource ContentBackBrush}" />
                                    <TextBlock Text="ContentBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource PanelBackBrush}" />
                                    <TextBlock Text="PanelBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource PanelLightBrush}" />
                                    <TextBlock Text="PanelLightBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource CardBackBrush}" />
                                    <TextBlock Text="CardBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource LogPanelBackBrush}" />
                                    <TextBlock Text="LogPanelBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource TitleBarBackBrush}" />
                                    <TextBlock Text="TitleBarBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource StatusBarBackBrush}" />
                                    <TextBlock Text="StatusBarBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource RightPanelBackBrush}" />
                                    <TextBlock Text="RightPanelBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource CardHeaderBackBrush}" />
                                    <TextBlock Text="CardHeaderBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource MenuItemBackBrush}" />
                                    <TextBlock Text="MenuItemBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource MenuItemHoverBrush}" />
                                    <TextBlock Text="MenuItemHoverBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource MenuItemSelectedBrush}" />
                                    <TextBlock Text="MenuItemSelectedBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="PrimaryBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="AccentBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 2. 语义背景色 ============ -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="2. 语义背景色（消息/徽章/终端）" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource InfoBackBrush}" />
                                    <TextBlock Text="InfoBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource WarnBackBrush}" />
                                    <TextBlock Text="WarnBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource SuccessBackBrush}" />
                                    <TextBlock Text="SuccessBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource DangerBackBrush}" />
                                    <TextBlock Text="DangerBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource TerminalBackBrush}" />
                                    <TextBlock Text="TerminalBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource TerminalTextBrush}" />
                                    <TextBlock Text="TerminalTextBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 3. 文本色 ============ -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="3. 文本色（TextBlock.Foreground）" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="TextDarkBrush 正文" FontSize="10" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" />
                                    <TextBlock Text="TextDarkBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="TextOnDarkBrush 面板底" FontSize="10" Foreground="{DynamicResource TextOnDarkBrush}" TextAlignment="Center" />
                                    <TextBlock Text="TextOnDarkBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="TextSecondaryBrush 次要" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" />
                                    <TextBlock Text="TextSecondaryBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="TextMutedBrush 弱化" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" />
                                    <TextBlock Text="TextMutedBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="TextDisabledBrush 禁用" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" TextAlignment="Center" />
                                    <TextBlock Text="TextDisabledBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource AccentBrush}">
                                        <TextBlock Text="TextOnAccentBrush" FontSize="9" Foreground="{DynamicResource TextOnAccentBrush}" TextAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="TextOnAccentBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 4. 边框色 ============ -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="4. 边框色（Border.BorderBrush）" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                        <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="2" />
                                    </Border>
                                    <TextBlock Text="BorderNormalBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                        <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="2" />
                                    </Border>
                                    <TextBlock Text="PanelBorderBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                        <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource SplitterBrush}" BorderThickness="2" />
                                    </Border>
                                    <TextBlock Text="SplitterBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                        <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource LogPanelBorderBrush}" BorderThickness="2" />
                                    </Border>
                                    <TextBlock Text="LogPanelBorderBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                        <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="2" />
                                    </Border>
                                    <TextBlock Text="WarnBorderBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 5. 状态色 ============ -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="5. 状态色（指示灯/徽标/强调）" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource StatusGreenBrush}" />
                                    <TextBlock Text="StatusGreenBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource StatusOrangeBrush}" />
                                    <TextBlock Text="StatusOrangeBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource StatusRedBrush}" />
                                    <TextBlock Text="StatusRedBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource StatusBlueBrush}" />
                                    <TextBlock Text="StatusBlueBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource StatusPurpleBrush}" />
                                    <TextBlock Text="StatusPurpleBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="200" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <Border Style="{StaticResource ColorSwatchStyle}" Background="{DynamicResource StatusGrayBrush}" />
                                    <TextBlock Text="StatusGrayBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 6. 按钮 ============ -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="6. 按钮（Button / ToggleButton / RepeatButton）" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <Border Style="{StaticResource DemoCellStyle}" Width="300" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="Button（默认，隐式样式）" Style="{StaticResource DemoLabelStyle}" />
                                    <Button Content="默认按钮" FontSize="10" MinHeight="22" Padding="8,0" HorizontalAlignment="Left" />
                                    <TextBlock Text="隐式 Button 默认样式（ButtonsAndToggles 定义）" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="300" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="Button（多尺寸）" Style="{StaticResource DemoLabelStyle}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="主" MinWidth="52" MinHeight="22" FontSize="10" Padding="0" Margin="0,0,4,0" />
                                        <Button Content="危" MinWidth="52" MinHeight="22" FontSize="10" Padding="0" Margin="0,0,4,0" />
                                        <Button Content="成" MinWidth="52" MinHeight="22" FontSize="10" Padding="0" />
                                    </StackPanel>
                                    <TextBlock Text="自绘 Button 样式，颜色全 DynamicResource" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="300" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="ToggleButton（切换）" Style="{StaticResource DemoLabelStyle}" />
                                    <ToggleButton Content="开关" FontSize="10" MinHeight="22" HorizontalAlignment="Left" MinWidth="70" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="300" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="Button（禁用态）" Style="{StaticResource DemoLabelStyle}" />
                                    <Button Content="不可用" FontSize="10" MinHeight="22" Padding="8,0" IsEnabled="False" HorizontalAlignment="Left" />
                                    <TextBlock Text="禁用态：暗底灰字（PanelBackBrush + TextDisabledBrush）" FontSize="8" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="300" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="RepeatButton（重复按钮）" Style="{StaticResource DemoLabelStyle}" />
                                    <RepeatButton Content="按住递增" FontSize="10" MinHeight="22" Padding="8,0" HorizontalAlignment="Left"
                                                  Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource TextOnAccentBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 7. 输入控件 ============ -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="7. 输入控件（TextBox 隐式样式自包含；页面变体在自身 XAML 定义本地键）" Style="{StaticResource SectionTitleStyle}" />
                        <WrapPanel>
                            <Border Style="{StaticResource DemoCellStyle}" Width="300" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="TextBox（文本框）" Style="{StaticResource DemoLabelStyle}" />
                                    <TextBox MinHeight="22" FontSize="10" Margin="0,0,0,4" Text="输入文本示例"
                                             Background="{DynamicResource PanelBackBrush}" Foreground="{DynamicResource TextDarkBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="300" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
                                    <TextBlock Text="PasswordBox（密码框）" Style="{StaticResource DemoLabelStyle}" />
                                    <PasswordBox MinHeight="22" FontSize="10" Margin="0,0,0,4" Password="123456" PasswordChar="●"
                                                 Background="{DynamicResource PanelBackBrush}" Foreground="{DynamicResource TextDarkBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DemoCellStyle}" Width="300" MouseLeftButtonUp="OnCellClick">
                                <StackPanel>
