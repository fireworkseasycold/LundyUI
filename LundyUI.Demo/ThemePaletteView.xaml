                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="4" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="CheckBox / RadioButton" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
