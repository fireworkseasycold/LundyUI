<UserControl x:Class="LundyUI.Demo.ThemePaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:appControls="clr-namespace:LundyUI.Controls.CustomControls;assembly=LundyUI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">

            <!-- ============ 标题 ============ -->
            <Border Background="{DynamicResource CardBackBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="🎨 UI 样式样板（Theme Palette）"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextDarkBrush}" />
                    <TextBlock Text="原生 WPF 控件 + 项目自定义控件平铺展示全部主题键效果：文本/背景/下拉框等一律使用标注 key 绑定，禁止混用。修改主题配置后切回本页验收。"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ 1. 背景色 ============ -->
            <Border Background="{DynamicResource CardBackBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="1. 背景色（Border.Background）"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDarkBrush}"
                               Margin="0,0,0,4" />
                    <UniformGrid Columns="6">
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource CardBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="CardBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource PanelBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="PanelBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource PanelLightBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="PanelLightBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource ContentBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="ContentBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource WindowBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="WindowBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource LogPanelBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="LogPanelBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource InfoBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="InfoBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource WarnBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="WarnBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource SuccessBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="SuccessBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource DangerBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="DangerBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource CardHeaderBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="CardHeaderBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="AccentBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource TitleBarBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="TitleBarBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource RightPanelBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="RightPanelBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource MenuItemBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="MenuItemBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource MenuItemHoverBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="MenuItemHoverBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource MenuItemSelectedBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="MenuItemSelectedBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource StatusBarBackBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="StatusBarBackBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource PrimaryBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="PrimaryBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ============ 2. 文本色 ============ -->
            <Border Background="{DynamicResource CardBackBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="2. 文本色（TextBlock.Foreground）"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDarkBrush}"
                               Margin="0,0,0,4" />
                    <UniformGrid Columns="6">
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="TextDarkBrush 正文" FontSize="10" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" />
                                <TextBlock Text="TextDarkBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource PanelBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="TextOnDarkBrush 面板底" FontSize="10" Foreground="{DynamicResource TextOnDarkBrush}" TextAlignment="Center" />
                                <TextBlock Text="TextOnDarkBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="TextSecondaryBrush 次要" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" />
                                <TextBlock Text="TextSecondaryBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="TextMutedBrush 弱化" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" />
                                <TextBlock Text="TextMutedBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="TextDisabledBrush 禁用" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" TextAlignment="Center" />
                                <TextBlock Text="TextDisabledBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" Padding="2">
                                    <TextBlock Text="TextOnAccentBrush" FontSize="9" Foreground="{DynamicResource TextOnAccentBrush}" TextAlignment="Center" />
                                </Border>
                                <TextBlock Text="TextOnAccentBrush" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ============ 3. 边框色 ============ -->
            <Border Background="{DynamicResource CardBackBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="3. 边框色（Border.BorderBrush）"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDarkBrush}"
                               Margin="0,0,0,4" />
                    <UniformGrid Columns="6">
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                    <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="2" />
                                </Border>
                                <TextBlock Text="BorderNormalBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                    <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="2" />
                                </Border>
                                <TextBlock Text="PanelBorderBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                    <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource SplitterBrush}" BorderThickness="2" />
                                </Border>
                                <TextBlock Text="SplitterBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                    <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource LogPanelBorderBrush}" BorderThickness="2" />
                                </Border>
                                <TextBlock Text="LogPanelBorderBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="18" CornerRadius="2" BorderBrush="#66808080" BorderThickness="1" Padding="1">
                                    <Border Height="14" CornerRadius="1" Background="{DynamicResource ContentBackBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="2" />
                                </Border>
                                <TextBlock Text="WarnBorderBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ============ 4. 状态色 ============ -->
            <Border Background="{DynamicResource CardBackBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="4. 状态色（指示灯/徽标/强调）"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDarkBrush}"
                               Margin="0,0,0,4" />
                    <UniformGrid Columns="6">
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource StatusGreenBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="StatusGreenBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource StatusOrangeBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="StatusOrangeBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource StatusRedBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="StatusRedBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource StatusBlueBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="StatusBlueBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource StatusPurpleBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="StatusPurpleBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="3" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <Border Height="16" CornerRadius="2" Background="{DynamicResource StatusGrayBrush}" BorderBrush="#66808080" BorderThickness="1" />
                                <TextBlock Text="StatusGrayBrush" FontSize="9" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ============ 5. 按钮 ============ -->
            <Border Background="{DynamicResource CardBackBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="6"
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="5. 按钮（Button / ToggleButton）"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDarkBrush}"
                               Margin="0,0,0,4" />
                    <UniformGrid Columns="4">
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="4" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
