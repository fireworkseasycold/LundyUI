                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="4" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="LoadingCircle（加载圈）" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                <appControls:LoadingCircleControl Width="32" Height="32" Margin="0,3,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="4" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="Pagination（分页）" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                <appControls:PaginationControl Height="32" Margin="0,3,0,0" HorizontalAlignment="Left"
                                                               MaxPageCount="8" PageIndex="2" IsJumpEnabled="True" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="3" Margin="2" Padding="4" VerticalAlignment="Top" MouseLeftButtonUp="OnCellClick" Cursor="Hand" ToolTip="点击放大查看">
                            <StackPanel>
                                <TextBlock Text="LoadingCircle（状态色）" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" />
                                <appControls:LoadingCircleControl Width="32" Height="32" Margin="0,3,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource StatusOrangeBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ============ 11. 统一绑定规范 ============ -->
            <Border Background="{DynamicResource CardBackBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8,6">
                <StackPanel>
                    <TextBlock Text="✅ 统一绑定规范（控件层以原生 WPF + 项目自定义控件为主；模板族统一由 Resource/Templates 提供）"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextDarkBrush}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="· 面板/卡片背景 → CardBackBrush；页面背景 → ContentBackBrush；日志区背景与卡片一致"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 明暗原则：背景与文字必须同明暗——暗底亮字 / 亮底暗字；禁用态统一暗底灰字（按钮禁用态、日历导航条等由 Resource/Templates 统一，禁止浅底深字）"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 模板内部控件（日历导航按钮等）一律 Style={x:Null} 彻底隔离隐式样式，禁止靠重置属性打补丁"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 类型匹配：Brush 属性只能绑 Brush 键（*Brush）；颜色一律在主题字典（ThemeShared / DynamicTheme）中声明"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 样板交互：点击任意展示格弹出放大预览（VisualBrush 实时引用原格子，主题跟随），点遮罩或右上角 ✕ 关闭"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 文本：正文 → TextDarkBrush；次要 → TextSecondaryBrush；弱化 → TextMutedBrush；禁用 → TextDisabledBrush"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 输入/数据控件一律原生类型（TextBox/ComboBox/ListBox/DataGrid/DatePicker/PasswordBox/TreeView 等）；基础外观由 Controls 隐式样式提供，页面变体在其自身 XAML 定义本地键（不再依赖全局共享基础键）"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 语义按钮：自绘隐式 Button 样式（ButtonsAndToggles 定义，颜色全 DynamicResource）；主/危/成语义键已并入普通按钮"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· DatePicker / Calendar / StatusBar 等控件在 Templates/Controls 中提供项目隐式样式覆盖，确保背景/前景严格跟随主题键，禁止原生/第三方模板硬编码浅色"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 点击/事件绑定一律原生：点击用 MouseBinding（InputBindings），其他事件用 XAML 事件 + 代码后置转发 VM 命令"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 滚动条/分隔条：使用 Templates/Controls/ListControls 提供的原生模板，无需单独绑定"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 项目自定义控件（DateTimePicker / LoadingCircle / Pagination）优先使用，事件用原生挂接"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="· 禁止：硬编码颜色、终端黑 TerminalBackBrush 类独立配色、第三方（hc: 等）前缀用法"
                               FontSize="10"
                               Foreground="{DynamicResource TextDarkBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
    <!-- ============ 放大预览浮层（点击展示格弹出；点遮罩或右上角 ✕ 关闭） ============ -->
    <Border x:Name="Overlay" Visibility="Collapsed" Background="{DynamicResource OverlayMaskBrush}" MouseLeftButtonUp="OnOverlayClick">
        <Border Width="820" MaxHeight="620" Background="{DynamicResource CardBackBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="8" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="OverlayTitle" Grid.Row="0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextDarkBrush}" TextWrapping="Wrap" Margin="0,0,34,8" />
                <ScrollViewer x:Name="OverlayScroll" Grid.Row="1" MaxWidth="760" MaxHeight="530" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ContentControl x:Name="OverlayHost" Focusable="False" />
                </ScrollViewer>
                <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource PanelLightBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" Cursor="Hand" ToolTip="关闭" MouseLeftButtonUp="OnCloseOverlay">
                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextDarkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Border>
    </Grid>
</UserControl>
